# Copy to .env and fill in your values (do not commit .env)

# PostgreSQL — prefer the PUBLIC URL from Railway Postgres → Variables
# Host looks like: something.proxy.rlwy.net (not postgres.railway.internal)
DATABASE_PUBLIC_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.proxy.rlwy.net:PORT/railway
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.proxy.rlwy.net:PORT/railway

# Persistent data (Railway: mount a Volume at /app/data)
# DATA_DIR=/app/data
# WHATSAPP_AUTH_DIR=/app/data/whatsapp-auth
# WHATSAPP_CACHE_DIR=/app/data/whatsapp-cache

# WhatsApp bridge (enabled by default on Docker/Railway)
WHATSAPP_ENABLED=1
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
